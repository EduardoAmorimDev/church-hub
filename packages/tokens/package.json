{
  "name": "@church/tokens",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/root.css": "./dist/styles/root.css"
  },
  "scripts": {
