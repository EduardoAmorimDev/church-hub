    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "tsup": "^8.5.1",
    "tsx": "4.23.15"
  }
}
